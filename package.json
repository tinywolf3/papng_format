{
  "name": "papng-format",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config demos/web/viewer/vite.config.ts",
    "build": "npm run typecheck && vite build --config demos/web/viewer/vite.config.ts",
    "preview": "vite preview --config demos/web/viewer/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "samples": "tsx tools/generate-samples.ts",
    "check": "npm run typecheck"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "json5": "2.2.3"
  }
}
