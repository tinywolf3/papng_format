{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "demos/**/*.ts",
    "tools/generate-samples.ts",
    "tools/sample-writer.ts"
  ]
}
